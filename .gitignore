# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# show-watch runs (screenshots, contact sheets, videos — all regenerable)
/artifacts/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env
.env*.local
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# private planets — personal YouTube imports, never committed or deployed
/public/private/
/scripts/import-youtube/wd/
/scripts/import-youtube/jobs/
/scripts/onboard-jobs/
/assets/*
!/assets/suno
/assets/suno/*
!/assets/suno/art
scripts/lexicon/cron.log
scripts/song-art/topup/
scripts/song-art/*-topup-*/
scripts/song-art/.topup-tmp/
scripts/song-art/topup-run.log
scripts/lexicon/art-run.log

# collector pipeline caches — all regenerable (audio from R2, renders duplicated in assets/ + R2)
scripts/song-art/collector/audio/
scripts/song-art/collector/out/
scripts/song-art/collector/gen/
scripts/song-art/collector/thumbs/
scripts/song-art/collector/web/
scripts/song-art/collector/originals/

# dynamic+ revert safety dumps (v1 plans also live in git history)
scripts/song-analysis/dynamic-plus-backup-*.jsonl

# ultimate-analyzer heavy artifacts (audio proxies re-downloadable from R2/Suno)
scripts/song-analysis/profiles/*/release.mp3
scripts/song-analysis/profiles/*/cover.jpeg
scripts/song-analysis/profiles/*/stems-src/
scripts/song-art/.backfill-tmp/

# melody/stems batch working dir (downloaded stem audio + generated json)
scripts/stem-analysis/out/

# lyrics inbox working files (canonical lyrics live in the DB after apply)
scripts/alignment/inbox/
scripts/curator/.cache/
scripts/lexicon/.night-current.log

# Splice Table — CLI scratch outputs (regenerate with compile.mjs / splice.mjs)
scripts/song-analysis/*.compiled.json
scripts/song-analysis/*.flow.json

# directed-cut render artifacts (masters/shares live in the profile dirs, not git)
# Broadened 2026-07-27: the -60 glob only caught one naming scheme, so 30/45/59s
# masters, share encodes and QA stills were all showing up as untracked.
scripts/song-analysis/profiles/*/*.mp4
scripts/song-analysis/profiles/*/qa-*.jpg
scripts/song-analysis/profiles/*/*-check*.jpg
scripts/song-analysis/profiles/*/*-60*.mp4
scripts/song-analysis/profiles/*/.render-*/
scripts/song-analysis/profiles/*/pre-refix-backup/
# Suno stem splits — 22MB per song, and they are re-derivable from the zip in
# assets/. Same policy as stems-src/ and stems_aligned/ above.
scripts/song-analysis/profiles/*/stems/
# whisper run logs are megabytes of progress-bar carriage returns; the JSON
# transcripts beside them are the part worth keeping.
scripts/song-analysis/profiles/*/whisper*/*.log
scripts/song-art/*-out/
# Art intermediates: mattes, blur-extended plates and composites. The webp that
# actually ships is published to public/planets/<slug>/; these are ~30MB of
# working PNGs, regenerable from extract-subject.py + the source photos.
scripts/song-art/*-cut/
scripts/song-art/*-real/
scripts/song-art/*-comp/
scripts/song-art/*-plates/
scripts/song-art/*-cloud/
# and never the working PNGs — only the shipped webp belongs in git
scripts/song-art/*/*.png
.env*

# python bytecode
__pycache__/
*.pyc

# Directed-cut working artifacts: the generated PNG plates (published as webp
# to R2), the QA frame sheets, and the render logs. The SCRIPTS in scripts/dts2
# are tracked — the 50MB of pixels they produce are not.
scripts/dts2/art-out/
scripts/dts2/*.log
scripts/dts2/measure-*.txt
scripts/fag/plates/
scripts/song-analysis/profiles/*/qa-*/

# Conformed stem exports live on R2 like every other master — no profile has
# ever tracked audio (release.mp3 is already ignored above) and hajimemashite's
# conformed set alone is 46MB.
scripts/song-analysis/profiles/*/stems_aligned/
